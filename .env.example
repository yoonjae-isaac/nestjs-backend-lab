NODE_ENV=development
PORT=3000
INSTANCE_ID=local-1
LOG_LEVEL=info

POSTGRES_ENABLED=false
POSTGRES_URL=postgresql://lab:lab@localhost:5432/backend_lab
POSTGRES_POOL_MAX=10

MYSQL_ENABLED=false
MYSQL_URL=mysql://lab:lab@localhost:3306/backend_lab
MYSQL_POOL_MAX=10

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=backend-lab
KAFKA_CONSUMER_GROUP_PREFIX=backend-lab
KAFKA_AUTO_CREATE_TOPICS=false

INVENTORY_NAIVE_DELAY_MS=10
INVENTORY_INIT_LOCK_TTL_MS=3000
INVENTORY_INIT_LOCK_WAIT_MS=3000
INVENTORY_INIT_LOCK_RETRY_MS=25
INVENTORY_CONSUMER_DELAY_MS=0
INVENTORY_POSTGRES_LOCK_TIMEOUT_MS=3000
INVENTORY_POSTGRES_STATEMENT_TIMEOUT_MS=5000

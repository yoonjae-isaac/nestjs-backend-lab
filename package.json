{
  "name": "nestjs-backend-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible NestJS backend engineering laboratory",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts,infra,load-tests}/**/*.{ts,js,mjs,json,md,yml,yaml}\" package.json nest-cli.json tsconfig.json tsconfig.build.json eslint.config.mjs README.md AGENTS.md",
    "format:check": "prettier --check \"{src,test,scripts,infra,load-tests}/**/*.{ts,js,mjs,json,md,yml,yaml}\" package.json nest-cli.json tsconfig.json tsconfig.build.json eslint.config.mjs README.md AGENTS.md",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.json",
    "lab:up": "node scripts/lab-compose.mjs up",
    "lab:down": "node scripts/lab-compose.mjs down",
    "lab:logs": "node scripts/lab-compose.mjs logs",
    "lab:config": "node scripts/lab-compose.mjs config",
    "infra:postgres": "docker compose -p backend-lab-postgres -f infra/shared/postgres.yml up -d",
    "infra:mysql": "docker compose -p backend-lab-mysql -f infra/shared/mysql.yml up -d",
    "infra:redis": "docker compose -p backend-lab-redis -f infra/shared/redis.yml up -d",
    "infra:kafka": "docker compose -p backend-lab-kafka -f infra/shared/kafka.yml up -d",
    "infra:kafka-ui": "docker compose -p backend-lab-kafka -f infra/shared/kafka.yml -f infra/shared/kafka-ui.yml up -d"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.14.5",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
